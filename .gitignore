# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# NOTE: pubspec.lock IS committed for apps (reproducible builds) — do not ignore it.
.idea/
*.iml
.vscode/            # keep local editor config out of the repo

