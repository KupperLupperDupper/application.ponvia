{
  "$schema": "https://design-tokens.org/ponvia",
  "name": "Ponvia",
  "version": "1.4.0",
  "brand": {
    "seedLight": "#1F6A5C",
    "seedDark": "#8ED8C4",
    "iconRadiusPercent": 22
  },
  "color": {
    "light": {
      "primary": "#1F6A5C",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#B3EEDD",
      "onPrimaryContainer": "#00201A",
      "secondary": "#4A635C",
      "surface": "#F6F8F7",
      "onSurface": "#171D1B",
      "surfaceContainer": "#EAEFEC",
      "surfaceContainerHighest": "#FFFFFF",
      "onSurfaceVariant": "#59635F",
      "outline": "#D3DBD8",
      "error": "#BA1A1A",
      "errorContainer": "#FFDAD6",
      "onErrorContainer": "#410002",
      "deltaDown": "#1F6A5C",
      "deltaUp": "#8A6238",
      "deltaUpContainer": "#F3E5D3",
      "onDeltaUpContainer": "#3E2E17",
      "deltaFlat": "#59635F",
      "chartLine": "#1F6A5C",
      "chartArea": "#B3EEDD",
      "chartAreaOpacity": 0.45,
      "chartGrid": "#E4EAE7",
      "scrim": "rgba(10,20,17,0.42)"
    },
    "dark": {
      "primary": "#8ED8C4",
      "onPrimary": "#00382F",
      "primaryContainer": "#005046",
      "onPrimaryContainer": "#B3EEDD",
      "secondary": "#B1CCC4",
      "surface": "#0E1412",
      "onSurface": "#DEE4E1",
      "surfaceContainer": "#1F2724",
      "surfaceContainerHighest": "#161D1B",
      "onSurfaceVariant": "#A6B0AC",
      "outline": "#333C39",
      "error": "#FFB4AB",
      "errorContainer": "#93000A",
      "onErrorContainer": "#FFDAD6",
      "deltaDown": "#8ED8C4",
      "deltaUp": "#E0BC88",
      "deltaUpContainer": "#4A3A22",
      "onDeltaUpContainer": "#F3E5D3",
      "deltaFlat": "#A6B0AC",
      "chartLine": "#8ED8C4",
      "chartArea": "#005046",
      "chartAreaOpacity": 0.65,
      "chartGrid": "#2A3431",
      "scrim": "rgba(0,0,0,0.60)"
    }
  },
  "typography": {
    "family": "Manrope",
    "monoFamily": "JetBrains Mono",
    "license": "SIL OFL 1.1",
    "tabularFigures": true,
    "styles": {
      "heroWeight": {
        "size": 72,
        "weight": 800,
        "lineHeight": 76,
        "tracking": -0.04
      },
      "display": {
        "size": 36,
        "weight": 800,
        "lineHeight": 42,
        "tracking": -0.02
      },
      "headline": {
        "size": 28,
        "weight": 800,
        "lineHeight": 34,
        "tracking": -0.02
      },
      "titleLarge": {
        "size": 22,
        "weight": 800,
        "lineHeight": 28,
        "tracking": -0.02
      },
      "title": {
        "size": 20,
        "weight": 700,
        "lineHeight": 26,
        "tracking": 0
      },
      "body": {
        "size": 16,
        "weight": 400,
        "lineHeight": 24,
        "tracking": 0
      },
      "bodyStrong": {
        "size": 16,
        "weight": 700,
        "lineHeight": 24,
        "tracking": 0
      },
      "label": {
        "size": 14,
        "weight": 700,
        "lineHeight": 20,
        "tracking": 0.01
      },
      "labelSmall": {
        "size": 12,
        "weight": 800,
        "lineHeight": 16,
        "tracking": 0.06,
        "uppercase": true
      }
    },
    "maxTextScaleTested": 1.3
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48
  ],
  "radii": {
    "chip": 20,
    "field": 16,
    "card": 24,
    "cardHero": 28,
    "button": 28,
    "sheet": 28,
    "dialog": 28,
    "fab": 18,
    "fabExtended": 20
  },
  "elevation": {
    "level0": {
      "dp": 0,
      "shadow": "none"
    },
    "level1": {
      "dp": 1,
      "shadow": "0 1 3 rgba(16,32,28,0.12)",
      "darkTonalOverlay": 0.05
    },
    "level2": {
      "dp": 3,
      "shadow": "0 4 14 rgba(16,32,28,0.16)",
      "darkTonalOverlay": 0.08
    },
    "level3": {
      "dp": 6,
      "shadow": "0 8 24 rgba(16,32,28,0.20)",
      "darkTonalOverlay": 0.11
    }
  },
  "motion": {
    "route": {
      "duration": 300,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "sheetOpen": {
      "duration": 350,
      "easing": "cubic-bezier(0.05,0.7,0.1,1)"
    },
    "sheetClose": {
      "duration": 250,
      "easing": "cubic-bezier(0.3,0,0.8,0.15)"
    },
    "valueChange": {
      "duration": 250,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "splashToApp": {
      "duration": 200,
      "easing": "cubic-bezier(0,0,0,1)"
    },
    "conditionalBlock": {
      "duration": 250,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "selection": {
      "duration": 120,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "snackbar": {
      "durationIn": 200,
      "durationOut": 150
    }
  },
  "icons": {
    "set": "Material Symbols Rounded",
    "opticalSize": 24,
    "weight": 400,
    "grade": 0,
    "fill": 0,
    "selectedNavFill": 1,
    "map": {
      "weight": "scale",
      "add": "add",
      "history": "show_chart",
      "goal": "flag",
      "achieved": "check_circle",
      "settings": "settings",
      "reminder": "notifications",
      "reminderOff": "notifications_off",
      "deltaDown": "arrow_downward",
      "deltaUp": "arrow_upward",
      "deltaFlat": "remove",
      "date": "event",
      "time": "schedule",
      "note": "edit_note",
      "export": "upload",
      "import": "download",
      "destructive": "delete_forever",
      "privacy": "lock",
      "language": "language",
      "theme": "contrast"
    }
  },
  "charts": {
    "sparkline": {
      "height": 68,
      "strokeWidth": 2.5,
      "curved": true,
      "curveSmoothness": 0.25,
      "showGrid": false,
      "showAxes": false,
      "endDotRadius": 4.5
    },
    "full": {
      "height": 170,
      "strokeWidth": 3,
      "gridLines": 4,
      "gridAxis": "horizontal",
      "maxBottomLabels": 5,
      "markerRadius": 6,
      "markerStrokeWidth": 3,
      "indicatorDash": [
        3,
        3
      ]
    }
  },
  "layout": {
    "screenPadding": 16,
    "cardPadding": 20,
    "cardGap": 12,
    "minTouchTarget": 48,
    "navBarHeight": 64,
    "appBarHeight": 56,
    "designWidth": 390,
    "navBlockHeight": 84,
    "contentBottomPadding": 80
  },
  "navigation": {
    "model": "bottomTabsWithCentreAdd",
    "destinations": [
      "home",
      "history",
      "goals",
      "settings"
    ],
    "labelBehavior": "none",
    "logEntry": "centreAddButton → modalBottomSheet",
    "addGoal": "appBarAction",
    "bar": {
      "height": 64,
      "humpRise": 20,
      "humpSpan": 134,
      "path": "M0,20 H128 C154,20 150,0 195,0 C240,0 236,20 262,20 H390 V84 H0 Z",
      "pathDesignWidth": 390
    },
    "addButton": {
      "size": 64,
      "glyph": 32,
      "shape": "circle",
      "fill": "primary",
      "pressedFill": {
        "light": "#175449",
        "dark": "#6FC3AE"
      },
      "collarTop": 10,
      "collarBottom": 10
    },
    "tabs": {
      "cellWidth": 64,
      "cellHeight": 64,
      "centreGap": 96,
      "indicator": {
        "width": 64,
        "height": 32,
        "radius": 16
      }
    }
  },
  "snackbar": {
    "inset": 16,
    "bottomInset": 98,
    "radius": 20,
    "elevation": "level3",
    "light": {
      "fill": "#173A34",
      "on": "#E3F3EE",
      "action": "#8ED8C4"
    },
    "dark": {
      "fill": "#1F2724",
      "outline": "#333C39",
      "on": "#DEE4E1",
      "action": "#8ED8C4"
    },
    "leadingTile": {
      "size": 36,
      "radius": 12,
      "fillOpacity": 0.16
    },
    "timer": {
      "trackHeight": 3,
      "singleMs": 4000,
      "bulkMs": 6000
    },
    "icons": {
      "single": "delete",
      "clearAll": "settings_backup_restore",
      "importReplace": "restore"
    }
  },
  "height": {
    "storage": "cm",
    "entry": { "metric": "cm", "imperial": "ft+in" },
    "range": { "cmMin": 100, "cmMax": 250 },
    "keypad": "NumericKeypad (shared with weight + goals)",
    "field": { "valueSize": 48, "valueWeight": 800, "unitSize": 18, "underline": 2 },
    "settingsRow": { "minHeight": 72, "icon": "height", "optional": true }
  },
  "bmi": {
    "showOnHome": "only when height is set",
    "emptyState": "none — no tile, no placeholder, no prompt",
    "slot": { "radius": 24, "minHeight": 104, "padding": [18, 20] },
    "value": { "size": 24, "weight": 800, "decimals": 1, "tabular": true, "color": "onSurface" },
    "label": { "size": 13, "color": "onSurfaceVariant" },
    "band": { "size": 13, "color": "onSurfaceVariant", "colorCoded": false, "words": ["below", "normal", "above"] },
    "appear": { "duration": 250, "type": "fade" },
    "gatesOtherFeatures": false
  },
  "appLock": {
    "settingsGroup": "security",
    "groupPosition": "after preferences, before data",
    "switches": { "appLock": "parent", "fingerprint": "nested, requires appLock + one successful auth" },
    "timeout": null,
    "pin": { "length": 4, "owner": "ponvia", "storage": "salted hash in platform secure storage", "submitButton": false, "verifyOn": "4th digit" },
    "lockScreen": {
      "disc": { "size": 72, "bg": "primaryContainer", "icon": "lock", "iconSize": 36, "iconColor": "primary" },
      "wordmark": { "size": 14, "weight": 700, "tracking": 0.18, "color": "onSurfaceVariant" },
      "title": { "size": 22, "weight": 800, "color": "onSurface" },
      "dots": { "count": 4, "size": 14, "gap": 20, "empty": "1.5 outline", "filled": "primary", "wrong": "error" },
      "hintRow": { "size": 14, "reservedHeight": 20 },
      "keypad": { "columns": 3, "keyHeight": 64, "keyRadius": 22, "gap": 12, "digitSize": 26, "lowerLeft": "fingerprint (only when enabled)", "lowerRight": "backspace" },
      "padding": { "horizontal": 24, "text": 40, "bottom": 34 },
      "footer": { "size": 13, "icon": "phone_android", "iconSize": 18 }
    },
    "motion": {
      "screenIn": { "duration": 250, "type": "fade" },
      "discAndDotsIn": { "stagger": 40, "scaleFrom": 0.94 },
      "keyPress": { "scale": 0.96, "duration": 90 },
      "dotFill": { "duration": 140, "curve": "emphasized", "scaleFrom": 0 },
      "dotClear": { "duration": 100 },
      "wrongPin": { "shake": { "duration": 320, "cycles": 3, "amplitude": 6 }, "haptic": "light" },
      "accepted": { "iconCrossfade": 180, "discScale": [1, 1.04, 1] },
      "toHome": { "duration": 220, "type": "fadeThrough" },
      "reducedMotion": "fades only"
    },
    "auth": { "biometricOnly": false, "ownLockoutTimer": false, "attemptCounter": false, "recovery": "none — clear data" },
    "triggers": ["coldStart", "resume"],
    "flagSecure": true
  },
  "goalReached": {
    "sheet": {
      "topRadius": 28,
      "container": "surfaceContainerHighest",
      "elevation": "level3",
      "paddingHorizontal": 24,
      "paddingBottom": 28,
      "height": "hug"
    },
    "handle": { "width": 36, "height": 4, "top": 12, "color": "outline", "opacity": 0.4 },
    "emblem": {
      "size": 64,
      "disc": "primaryContainer",
      "icon": "check_circle",
      "iconSize": 36,
      "iconColor": "primary",
      "marginTop": 28
    },
    "title": { "size": 23, "weight": 800, "tracking": -0.02, "color": "onSurface", "marginTop": 24 },
    "body": { "size": 15, "weight": 400, "color": "onSurfaceVariant", "tabular": true, "marginTop": 8, "maxLines": 1 },
    "confirmButton": { "type": "filled", "height": 56, "radius": 28, "fullWidth": true, "marginTop": 28 },
    "dismissButton": { "type": "text", "height": 48, "size": 15, "weight": 700, "color": "primary", "marginTop": 8 },
    "scrim": { "light": "rgba(10,20,17,0.42)", "dark": "rgba(0,0,0,0.60)" },
    "motion": {
      "sheetIn": { "duration": 350, "curve": "emphasizedDecelerate" },
      "sheetOut": { "duration": 250, "curve": "emphasizedAccelerate" },
      "emblem": { "duration": 250, "curve": "standardDecelerate", "scaleFrom": 0.92, "fadeFrom": 0 }
    },
    "oncePerGoal": true,
    "directionAgnostic": true,
    "followUpSnackbarDuration": 4000
  },
  "privacy": {
    "heroTile": 96,
    "heroRadius": 30,
    "heroGlyph": 44,
    "cardRadius": 24,
    "rowIconTile": 36,
    "rowIconRadius": 12
  }
}