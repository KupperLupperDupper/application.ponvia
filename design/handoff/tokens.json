{
  "$schema": "https://design-tokens.org/ponvia",
  "name": "Ponvia",
  "version": "1.1.0",
  "brand": {
    "seedLight": "#1F6A5C",
    "seedDark": "#8ED8C4",
    "iconRadiusPercent": 22
  },
  "color": {
    "light": {
      "primary": "#1F6A5C",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#B3EEDD",
      "onPrimaryContainer": "#00201A",
      "secondary": "#4A635C",
      "surface": "#F6F8F7",
      "onSurface": "#171D1B",
      "surfaceContainer": "#EAEFEC",
      "surfaceContainerHighest": "#FFFFFF",
      "onSurfaceVariant": "#59635F",
      "outline": "#D3DBD8",
      "error": "#BA1A1A",
      "errorContainer": "#FFDAD6",
      "onErrorContainer": "#410002",
      "deltaDown": "#1F6A5C",
      "deltaUp": "#8A6238",
      "deltaUpContainer": "#F3E5D3",
      "onDeltaUpContainer": "#3E2E17",
      "deltaFlat": "#59635F",
      "chartLine": "#1F6A5C",
      "chartArea": "#B3EEDD",
      "chartAreaOpacity": 0.45,
      "chartGrid": "#E4EAE7",
      "scrim": "rgba(10,20,17,0.42)"
    },
    "dark": {
      "primary": "#8ED8C4",
      "onPrimary": "#00382F",
      "primaryContainer": "#005046",
      "onPrimaryContainer": "#B3EEDD",
      "secondary": "#B1CCC4",
      "surface": "#0E1412",
      "onSurface": "#DEE4E1",
      "surfaceContainer": "#1F2724",
      "surfaceContainerHighest": "#161D1B",
      "onSurfaceVariant": "#A6B0AC",
      "outline": "#333C39",
      "error": "#FFB4AB",
      "errorContainer": "#93000A",
      "onErrorContainer": "#FFDAD6",
      "deltaDown": "#8ED8C4",
      "deltaUp": "#E0BC88",
      "deltaUpContainer": "#4A3A22",
      "onDeltaUpContainer": "#F3E5D3",
      "deltaFlat": "#A6B0AC",
      "chartLine": "#8ED8C4",
      "chartArea": "#005046",
      "chartAreaOpacity": 0.65,
      "chartGrid": "#2A3431",
      "scrim": "rgba(0,0,0,0.60)"
    }
  },
  "typography": {
    "family": "Manrope",
    "monoFamily": "JetBrains Mono",
    "license": "SIL OFL 1.1",
    "tabularFigures": true,
    "styles": {
      "heroWeight": {
        "size": 72,
        "weight": 800,
        "lineHeight": 76,
        "tracking": -0.04
      },
      "display": {
        "size": 36,
        "weight": 800,
        "lineHeight": 42,
        "tracking": -0.02
      },
      "headline": {
        "size": 28,
        "weight": 800,
        "lineHeight": 34,
        "tracking": -0.02
      },
      "titleLarge": {
        "size": 22,
        "weight": 800,
        "lineHeight": 28,
        "tracking": -0.02
      },
      "title": {
        "size": 20,
        "weight": 700,
        "lineHeight": 26,
        "tracking": 0
      },
      "body": {
        "size": 16,
        "weight": 400,
        "lineHeight": 24,
        "tracking": 0
      },
      "bodyStrong": {
        "size": 16,
        "weight": 700,
        "lineHeight": 24,
        "tracking": 0
      },
      "label": {
        "size": 14,
        "weight": 700,
        "lineHeight": 20,
        "tracking": 0.01
      },
      "labelSmall": {
        "size": 12,
        "weight": 800,
        "lineHeight": 16,
        "tracking": 0.06,
        "uppercase": true
      }
    },
    "maxTextScaleTested": 1.3
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48
  ],
  "radii": {
    "chip": 20,
    "field": 16,
    "card": 24,
    "cardHero": 28,
    "button": 28,
    "sheet": 28,
    "dialog": 28,
    "fab": 18,
    "fabExtended": 20
  },
  "elevation": {
    "level0": {
      "dp": 0,
      "shadow": "none"
    },
    "level1": {
      "dp": 1,
      "shadow": "0 1 3 rgba(16,32,28,0.12)",
      "darkTonalOverlay": 0.05
    },
    "level2": {
      "dp": 3,
      "shadow": "0 4 14 rgba(16,32,28,0.16)",
      "darkTonalOverlay": 0.08
    },
    "level3": {
      "dp": 6,
      "shadow": "0 8 24 rgba(16,32,28,0.20)",
      "darkTonalOverlay": 0.11
    }
  },
  "motion": {
    "route": {
      "duration": 300,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "sheetOpen": {
      "duration": 350,
      "easing": "cubic-bezier(0.05,0.7,0.1,1)"
    },
    "sheetClose": {
      "duration": 250,
      "easing": "cubic-bezier(0.3,0,0.8,0.15)"
    },
    "valueChange": {
      "duration": 250,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "splashToApp": {
      "duration": 200,
      "easing": "cubic-bezier(0,0,0,1)"
    },
    "conditionalBlock": {
      "duration": 250,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "selection": {
      "duration": 120,
      "easing": "cubic-bezier(0.2,0,0,1)"
    },
    "snackbar": {
      "durationIn": 200,
      "durationOut": 150
    }
  },
  "icons": {
    "set": "Material Symbols Rounded",
    "opticalSize": 24,
    "weight": 400,
    "grade": 0,
    "fill": 0,
    "selectedNavFill": 1,
    "map": {
      "weight": "scale",
      "add": "add",
      "history": "show_chart",
      "goal": "flag",
      "achieved": "check_circle",
      "settings": "settings",
      "reminder": "notifications",
      "reminderOff": "notifications_off",
      "deltaDown": "arrow_downward",
      "deltaUp": "arrow_upward",
      "deltaFlat": "remove",
      "date": "event",
      "time": "schedule",
      "note": "edit_note",
      "export": "upload",
      "import": "download",
      "destructive": "delete_forever",
      "privacy": "lock",
      "language": "language",
      "theme": "contrast"
    }
  },
  "charts": {
    "sparkline": {
      "height": 68,
      "strokeWidth": 2.5,
      "curved": true,
      "curveSmoothness": 0.25,
      "showGrid": false,
      "showAxes": false,
      "endDotRadius": 4.5
    },
    "full": {
      "height": 170,
      "strokeWidth": 3,
      "gridLines": 4,
      "gridAxis": "horizontal",
      "maxBottomLabels": 5,
      "markerRadius": 6,
      "markerStrokeWidth": 3,
      "indicatorDash": [
        3,
        3
      ]
    }
  },
  "layout": {
    "screenPadding": 16,
    "cardPadding": 20,
    "cardGap": 12,
    "minTouchTarget": 48,
    "navBarHeight": 64,
    "appBarHeight": 56,
    "designWidth": 390,
    "navBlockHeight": 84,
    "contentBottomPadding": 80
  },
  "navigation": {
    "model": "bottomTabsWithCentreAdd",
    "destinations": [
      "home",
      "history",
      "goals",
      "settings"
    ],
    "labelBehavior": "none",
    "logEntry": "centreAddButton → modalBottomSheet",
    "addGoal": "appBarAction",
    "bar": {
      "height": 64,
      "humpRise": 20,
      "humpSpan": 134,
      "path": "M0,20 H128 C154,20 150,0 195,0 C240,0 236,20 262,20 H390 V84 H0 Z",
      "pathDesignWidth": 390
    },
    "addButton": {
      "size": 64,
      "glyph": 32,
      "shape": "circle",
      "fill": "primary",
      "pressedFill": {
        "light": "#175449",
        "dark": "#6FC3AE"
      },
      "collarTop": 10,
      "collarBottom": 10
    },
    "tabs": {
      "cellWidth": 64,
      "cellHeight": 64,
      "centreGap": 96,
      "indicator": {
        "width": 64,
        "height": 32,
        "radius": 16
      }
    }
  },
  "snackbar": {
    "inset": 16,
    "bottomInset": 98,
    "radius": 20,
    "elevation": "level3",
    "light": {
      "fill": "#173A34",
      "on": "#E3F3EE",
      "action": "#8ED8C4"
    },
    "dark": {
      "fill": "#1F2724",
      "outline": "#333C39",
      "on": "#DEE4E1",
      "action": "#8ED8C4"
    },
    "leadingTile": {
      "size": 36,
      "radius": 12,
      "fillOpacity": 0.16
    },
    "timer": {
      "trackHeight": 3,
      "singleMs": 4000,
      "bulkMs": 6000
    },
    "icons": {
      "single": "delete",
      "clearAll": "settings_backup_restore",
      "importReplace": "restore"
    }
  },
  "privacy": {
    "heroTile": 96,
    "heroRadius": 30,
    "heroGlyph": 44,
    "cardRadius": 24,
    "rowIconTile": 36,
    "rowIconRadius": 12
  }
}